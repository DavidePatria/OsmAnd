{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:osmand-junction:envelope:1",
  "description": "V1 wire envelope. Geometry consistency, point totals, references and request-clock rules are enforced by executable validators.",
  "type": "object",
  "required": [
    "version",
    "kind",
    "epoch",
    "requestId"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "junction_request",
        "junction_snapshot",
        "junction_unavailable"
      ]
    },
    "epoch": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "requestId": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "scene": {
      "$ref": "urn:osmand-junction:scene:1"
    },
    "reason": {
      "type": "string",
      "maxLength": 80
    },
    "displayedSession": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "displayedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "displayedSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "displayedState": {
      "enum": [
        "active",
        "idle",
        "recalculating",
        "unavailable",
        "stale_source",
        "stale_transport",
        "arrived"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "junction_snapshot"
          }
        }
      },
      "then": {
        "required": [
          "scene"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "junction_unavailable"
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "not": {
          "required": [
            "scene"
          ]
        }
      }
    }
  ],
  "dependentRequired": {
    "displayedSession": [
      "displayedGeneration",
      "displayedSeq",
      "displayedState"
    ],
    "displayedGeneration": [
      "displayedSession",
      "displayedSeq",
      "displayedState"
    ],
    "displayedSeq": [
      "displayedSession",
      "displayedGeneration",
      "displayedState"
    ],
    "displayedState": [
      "displayedSession",
      "displayedGeneration",
      "displayedSeq"
    ]
  }
}
